@model EventPage
@{
    ViewData["Title"] = "Event categories";
}

<a class="back" asp-action="Index">← Your events</a>

@* ---------- Heading + add button ---------- *@
<div class="section-heading">
    <div>
        <h1>Categories</h1>
        <p>@Model.Name</p>
    </div>
    <a class="button" asp-action="Category" asp-route-eventId="@Model.EventId">+ Add category</a>
</div>

@* ---------- Categories table ---------- *@
<div class="panel table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Distance</th>
                <th>Fee</th>
                <th>Capacity</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.DistanceKm km</td>
                    <td>R @c.EntryFee.ToString("N2")</td>
                    <td>@c.Capacity</td>
                    <td>@(c.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Category"
                           asp-route-eventId="@Model.EventId"
                           asp-route-categoryId="@c.CategoryId">Edit</a>

                        <form asp-action="DeleteCategory" method="post" data-confirm="Delete this category?">
                            <input type="hidden" name="eventId" value="@Model.EventId">
                            <input type="hidden" name="categoryId" value="@c.CategoryId">
                            <button class="danger small">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Empty state *@
    @if (!Model.Categories.Any())
    {
        <p>No categories yet. Add a distance or age category for participants to choose.</p>
    }
</div>