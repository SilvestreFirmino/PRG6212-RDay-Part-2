@{ var role = Context.Session.GetString("Role"); }
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewData["Title"] | RaceDay</title><link rel="stylesheet" href="~/vendor/bootstrap.min.css"><link rel="stylesheet" href="~/site.css" asp-append-version="true"></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><nav class="nav-wrap" aria-label="Main navigation">
<a class="brand" asp-controller="Home" asp-action="Index">RaceDay<span class="brand-dot">.</span><small>South African road events</small></a>
<div class="nav-links"><a asp-controller="Home" asp-action="Index">Find an event</a>
@if(role == "Organiser"){<a asp-controller="Organiser" asp-action="Index">Dashboard</a><a asp-controller="Organiser" asp-action="Create">Create event</a>}
@if(role == "Participant"){<a asp-controller="Participant" asp-action="Index">My events</a><a asp-controller="Participant" asp-action="Results">My results</a>}
@if(role != null){<a asp-controller="Profile" asp-action="Index">My profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button">Sign out</button></form>}
else{<a asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-button" asp-controller="Account" asp-action="Register">Join RaceDay ↗</a>}
</div></nav></header>
<main id="main" class="page-wrap">
@if(TempData["Success"] is string success){<div class="notice success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="notice error" role="alert">@error</div>}
@RenderBody()</main><footer><div class="page-wrap"><strong>RaceDay.</strong><span>Every pace. Every finish line.</span><small>Made for South Africa's running, walking & cycling community.</small></div></footer>
<script src="~/site.js" asp-append-version="true"></script></body></html>
